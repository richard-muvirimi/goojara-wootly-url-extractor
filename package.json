{
  "name": "goojara",
  "version": "1.0.0",
  "description": "Simple bash / node script to extract Goojara / Wootly video urls. Handles the random advert redirects and just returns the video url.",
  "main": "index.js",
  "scripts": {
    "start": "echo \"View readme file\"",
    "path:linux": "echo \"#!/usr/bin/env sh\n\nnode $(pwd)/index.js expose \"'$@' > ~/.local/bin/goojara && chmod +x ~/.local/bin/goojara",
    "path:windows" : "echo \"node %cd%\\index.js expose %*\" > %USERPROFILE%\\AppData\\Roaming\\npm\\goojara.cmd",
    "unpath:linux": "rm ~/.local/bin/goojara",
    "unpath:windows": "rm %USERPROFILE%\\AppData\\Roaming\\npm\\goojara.cmd"
  },
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "log4js": "^6.9.1",
    "luxon": "^3.4.4",
    "puppeteer": "^19.3.0"
  },
  "author": "Richard Muvirimi <richard@tyganeutronics.com>",
  "license": "ISC"
}
